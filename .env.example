# Copie os valores para variáveis de ambiente. Não grave tokens reais neste arquivo.
BLAZE_AUTHORIZATION=Bearer SEU_TOKEN
BLAZE_WALLET_ID=SUA_CARTEIRA
BLAZE_USERNAME=SEU_USUARIO
BLAZE_RANK=SEU_RANK
BLAZE_ROOM_ID=4

# Opcionais, caso estejam presentes na requisição capturada no navegador.
BLAZE_SESSION_ID=
BLAZE_CLIENT_VERSION=
